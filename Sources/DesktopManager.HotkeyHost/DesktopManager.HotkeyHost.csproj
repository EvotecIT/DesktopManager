    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopManager\DesktopManager.csproj" />
  </ItemGroup>

</Project>
