<UserControl
    x:Class="DesktopManager.App.DesktopStatePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="20" ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="System and session" />
                        <Button Grid.Column="1" Content="Refresh all" Click="RefreshButton_Click" />
                    </Grid>
                    <TextBlock x:Name="SystemStateText" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ToggleSwitch
                            x:Name="KeepAwakeSwitch"
                            Header="Keep awake"
                            OffContent="Off"
                            OnContent="System + display"
                            Toggled="KeepAwakeSwitch_Toggled" />
                        <Button VerticalAlignment="Bottom" Content="Lock session" Click="LockSessionButton_Click" />
                    </StackPanel>
                    <InfoBar x:Name="StatusInfo" IsOpen="False" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Workstation profiles" />
                    <TextBox x:Name="WorkstationProfileNameBox" Header="Profile name" PlaceholderText="office" />
                    <ComboBox x:Name="WorkstationProfilesComboBox" Header="Stored profiles" HorizontalAlignment="Stretch" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save current" Click="SaveWorkstationProfileButton_Click" />
                        <Button Content="Apply" Click="ApplyWorkstationProfileButton_Click" />
                        <Button Content="Delete" Click="DeleteWorkstationProfileButton_Click" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Profiles combine monitor modes, wallpapers and personalization, taskbars, brightness/HDR where supported, and active audio defaults."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Audio endpoints" />
                    <ComboBox
                        x:Name="AudioEndpointsComboBox"
                        DisplayMemberPath="Name"
                        Header="Active endpoint"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="AudioEndpointsComboBox_SelectionChanged" />
                    <Slider x:Name="AudioVolumeSlider" Header="Master volume" Minimum="0" Maximum="100" StepFrequency="1" />
                    <ToggleSwitch x:Name="AudioMutedSwitch" Header="Mute" OffContent="Audible" OnContent="Muted" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <CheckBox x:Name="ConsoleRoleCheckBox" Content="Console" />
                        <CheckBox x:Name="MultimediaRoleCheckBox" Content="Multimedia" />
                        <CheckBox x:Name="CommunicationsRoleCheckBox" Content="Communications" />
                    </StackPanel>
                    <Button HorizontalAlignment="Left" Content="Apply audio" Click="ApplyAudioButton_Click" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Personalization and taskbar" />
                    <ToggleSwitch x:Name="TaskbarAutoHideSwitch" Header="Taskbar auto-hide" OffContent="Off" OnContent="On" />
                    <Button HorizontalAlignment="Left" Content="Apply taskbar" Click="ApplyTaskbarButton_Click" />
                    <TextBox x:Name="PersonalizationNameBox" Header="Snapshot name" PlaceholderText="before-theme-change" />
                    <ComboBox x:Name="PersonalizationSnapshotsComboBox" Header="Stored snapshots" HorizontalAlignment="Stretch" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save current" Click="SavePersonalizationButton_Click" />
                        <Button Content="Restore" Click="RestorePersonalizationButton_Click" />
                        <Button Content="Delete" Click="DeletePersonalizationButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Supported Windows radios" />
                    <ComboBox
                        x:Name="RadiosComboBox"
                        DisplayMemberPath="Name"
                        Header="Radio"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="RadiosComboBox_SelectionChanged" />
                    <ComboBox x:Name="RadioStateComboBox" Header="Explicit state" HorizontalAlignment="Stretch" />
                    <Button HorizontalAlignment="Left" Content="Apply radio state" Click="ApplyRadioButton_Click" />
                    <Expander Header="Experimental global airplane mode">
                        <StackPanel Padding="0,8,0,0" Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Uses an undocumented Windows shell contract. Prefer the supported per-radio controls above."
                                TextWrapping="Wrap" />
                            <CheckBox x:Name="ExperimentalAirplaneAcknowledgement" Content="I understand this API is experimental" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Get state" Click="GetAirplaneModeButton_Click" />
                                <Button Content="Enable" Click="EnableAirplaneModeButton_Click" />
                                <Button Content="Disable" Click="DisableAirplaneModeButton_Click" />
                            </StackPanel>
                            <TextBlock x:Name="AirplaneModeStateText" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Supported virtual desktop operations" />
                    <TextBox x:Name="VirtualDesktopWindowHandleBox" Header="Window handle" PlaceholderText="0x123456" />
                    <TextBox x:Name="VirtualDesktopIdBox" Header="Desktop ID" PlaceholderText="00000000-0000-0000-0000-000000000000" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Inspect window" Click="InspectVirtualDesktopButton_Click" />
                        <Button Content="Move window" Click="MoveVirtualDesktopButton_Click" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="The public Windows API can inspect a window and move it to a known desktop ID; it cannot enumerate, create, rename, or switch desktops."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
