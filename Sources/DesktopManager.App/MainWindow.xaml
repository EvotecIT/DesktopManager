<Window
    x:Class="DesktopManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:DesktopManager.App.Core"
    xmlns:local="using:DesktopManager.App">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="20,16"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="DesktopManager" />
                    <TextBlock
                        x:Name="ProfilePathText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="RuntimeStatusText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Runtime not started"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="18">
                    <Button
                        Content="Apply Rules"
                        Click="ApplyRulesButton_Click" />
                    <ToggleSwitch
                        x:Name="EnabledSwitch"
                        Header="Hotkeys"
                        IsOn="True"
                        OffContent="Disabled"
                        OnContent="Enabled"
                        Toggled="EnabledSwitch_Toggled" />
                    <ToggleSwitch
                        x:Name="StartWithWindowsSwitch"
                        Header="Startup"
                        OffContent="Off"
                        OnContent="On"
                        Toggled="StartWithWindowsSwitch_Toggled" />
                    <ToggleSwitch
                        x:Name="MinimizeToTraySwitch"
                        Header="Tray"
                        IsOn="True"
                        OffContent="Off"
                        OnContent="On"
                        Toggled="MinimizeToTraySwitch_Toggled" />
                    <ToggleSwitch
                        x:Name="ApplyRulesOnStartupSwitch"
                        Header="Rules"
                        OffContent="Manual"
                        OnContent="Auto"
                        Toggled="ApplyRulesOnStartupSwitch_Toggled" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Padding="20"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="240" />
                <RowDefinition Height="176" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                MinWidth="0"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Configured Functions" />
                            <TextBlock
                                x:Name="FunctionCountText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Content="New Action"
                            Click="NewActionButton_Click" />

                        <Button
                            Grid.Column="2"
                            Content="Reload"
                            Click="ReloadButton_Click" />
                    </Grid>

                    <ListView
                        x:Name="FunctionsList"
                        Grid.Row="1"
                        Height="190"
                        IsItemClickEnabled="True"
                        SelectionChanged="FunctionsList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:HotkeyFunctionDefinition">
                                <Grid
                                    Padding="4"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox
                                        IsChecked="{Binding Enabled}"
                                        IsHitTestVisible="False" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Category}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="{Binding Hotkey}"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ActionType}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Monitor HDR" />

                        <Button
                            Grid.Column="1"
                            Content="Refresh"
                            Click="RefreshHdrButton_Click" />

                        <Button
                            Grid.Column="2"
                            Content="Enable"
                            Click="EnableHdrButton_Click" />

                        <Button
                            Grid.Column="3"
                            Content="Disable"
                            Click="DisableHdrButton_Click" />
                    </Grid>

                    <ListView
                        x:Name="AdvancedColorList"
                        Grid.Row="1"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:MonitorAdvancedColorOption">
                                <Grid Padding="4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Details}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{Binding HdrState}"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Mode}"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding SdrWhite}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Selected Action" />

                            <Button
                                x:Name="TestActionButton"
                                Grid.Column="1"
                                Content="Test"
                                Click="TestActionButton_Click" />

                            <Button
                                x:Name="DiagnoseHotkeyButton"
                                Grid.Column="2"
                                Content="Diagnose"
                                Click="DiagnoseHotkeyButton_Click" />

                            <Button
                                x:Name="SaveActionButton"
                                Grid.Column="3"
                                Content="Save"
                                Click="SaveActionButton_Click" />

                            <Button
                                x:Name="DeleteActionButton"
                                Grid.Column="4"
                                Content="Delete"
                                Click="DeleteActionButton_Click" />
                        </Grid>

                        <InfoBar
                            x:Name="ValidationInfo"
                            IsOpen="False"
                            Severity="Warning"
                            Title="Profile warning" />

                        <TextBox
                            x:Name="SelectedNameText"
                            Header="Name"
                            Text="No function selected"
                            TextWrapping="Wrap" />

                        <ToggleSwitch
                            x:Name="SelectedActionEnabledSwitch"
                            Header="Action"
                            OffContent="Disabled"
                            OnContent="Enabled" />

                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="DiagnosticSummaryText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="No diagnostic selected"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="DiagnosticDetailsText"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Hotkey" />
                                <TextBox x:Name="SelectedHotkeyBox" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Placement" />
                                <ComboBox
                                    x:Name="SelectedPlacementComboBox"
                                    HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Spacing="4">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Target" />
                                <TextBlock x:Name="SelectedTargetText" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Monitor" />
                                <TextBlock x:Name="SelectedMonitorText" />
                            </StackPanel>
                        </Grid>

                        <ComboBox
                            x:Name="MonitorIndexComboBox"
                            DisplayMemberPath="DisplayName"
                            Header="Monitor binding" />

                        <ToggleSwitch
                            x:Name="SelectedVerifySwitch"
                            Header="Verify after action"
                            OffContent="Off"
                            OnContent="On" />

                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="RuleTitlePatternBox"
                                Header="Rule title pattern"
                                PlaceholderText="*" />

                            <TextBox
                                x:Name="RuleProcessPatternBox"
                                Grid.Column="1"
                                Header="Rule process pattern"
                                PlaceholderText="pwsh*" />

                            <Button
                                x:Name="AddRuleButton"
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Content="Add Rule"
                                Click="AddRuleButton_Click" />
                        </Grid>

                        <Grid ColumnSpacing="10" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="96" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Layout Rules" />

                            <Button
                                x:Name="ToggleRuleButton"
                                Grid.Column="1"
                                Content="Enable/Disable"
                                Click="ToggleRuleButton_Click" />

                            <Button
                                x:Name="DeleteRuleButton"
                                Grid.Column="2"
                                Content="Delete Rule"
                                Click="DeleteRuleButton_Click" />

                            <ListView
                                x:Name="RulesList"
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:WindowRuleOption">
                                        <Grid Padding="4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox
                                                IsChecked="{Binding IsEnabled}"
                                                IsHitTestVisible="False" />

                                            <StackPanel Grid.Column="1">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Details}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="1" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Runtime Log" />

                        <ListView
                            x:Name="ActionLogList"
                            Grid.Row="1"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:RuntimeLogEntry">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding TimeText}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Message}"
                                            TextWrapping="WrapWholeWords" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
